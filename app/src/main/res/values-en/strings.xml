    <string name="about_credit_zxing">The QR code is generated locally by zxing — no network, no INTERNET permission.</string>
    <string name="about_changelog_section">Release notes</string>
    <string name="about_changelog_title">In this version</string>
    <string name="about_change_1">Tracked list on the main screen, tap to freeze, long press to pin</string>
